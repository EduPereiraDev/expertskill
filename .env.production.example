# ============================================
# ExpertSkill — Variáveis de Produção
# ============================================

# Node
NODE_ENV=production
PORT=3001

# Database (PostgreSQL)
# Adicionar ?connection_limit=10 para evitar esgotar conexões
DATABASE_URL="postgresql://user:password@localhost:5432/expertskill?connection_limit=10&connect_timeout=30"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (TROCAR em produção!)
JWT_SECRET="gerar-com-openssl-rand-base64-64"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (PRODUÇÃO — usar chaves sk_live_)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_1T0YA2K2POLU58mIAmXf8HO1"
STRIPE_EXPERT_PRICE_ID="price_1T0YBdK2POLU58mIuSRa7CgQ"

# OpenAI (opcional)
OPENAI_API_KEY="sk-..."

# Telegram (opcional)
TELEGRAM_BOT_TOKEN="123456:ABC..."

# URLs (TROCAR pelo domínio real)
# Múltiplos origins separados por vírgula
FRONTEND_URL="https://expertskills.com.br,https://www.expertskills.com.br"
